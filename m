 arch/arm/mach-omap1/ams-delta-fiq.c              |  175 +++++++++++++++++++++++
 arch/arm/mach-omap1/include/mach/ams-delta-fiq.h |   56 +++++++
 3 files changed, 232 insertions(+), 1 deletion(-)

