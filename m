> + * Area definition for DMM physical address translator.
> + */
> +struct pat_area {
> +	s32 x0:8;
Any particular reason of choosing s32 ?=20
> +	s32 y0:8;
> +	s32 x1:8;
> +	s32 y1:8;
> +};
> +
> +/**
> + * DMM physical address translator control.
> + */
> +struct pat_ctrl {
