> +(((reg) & ~MASK((msb), (lsb))) | (((val) << (lsb)) & MASK((msb), (lsb)))=
)
> +
> +static struct platform_driver dmm_driver_ldm =3D {
> +	.driver =3D {
> +		.owner =3D THIS_MODULE,
> +		.name =3D "dmm",
> +	},
> +	.probe =3D NULL,
