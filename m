   241	static int mtu3_prepare_tx_gpd(struct mtu3_ep *mep, struct mtu3_request *mreq)
   242	{
   243		struct qmu_gpd *enq;
   244		struct mtu3_gpd_ring *ring = &mep->gpd_ring;
