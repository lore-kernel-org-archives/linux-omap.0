-	.volt_reg_addr		= OMAP4_VDD_CORE_SR_VOLT_REG,
-	.cmd_reg_addr		= OMAP4_VDD_CORE_SR_CMD_REG,
-	.i2c_high_speed		= true,
-	.i2c_pad_load		= 3,
