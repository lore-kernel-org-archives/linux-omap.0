 objs-y$(CONFIG_ARCH_OMAP1) +=3D lcdc.o
-objs-y$(CONFIG_ARCH_OMAP2) +=3D dispc.o
-objs-y$(CONFIG_ARCH_OMAP3) +=3D dispc.o
