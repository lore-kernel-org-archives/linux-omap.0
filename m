   252	
   253		gpd->buffer = cpu_to_le32(lower_32_bits(req->dma));
   254		ext_addr = GPD_EXT_BUF(upper_32_bits(req->dma));
   255		gpd->buf_len = cpu_to_le16(req->length);
   256		gpd->flag |= GPD_FLAGS_IOC;
   257	
   258		/* get the next GPD */
