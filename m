-static void rfbi_write_command(const void *buf, unsigned int len)
-{
-	rfbi_enable_clocks(1);
-	if (rfbi.bits_per_cycle =3D=3D 16) {
-		const u16 *w =3D buf;
-		BUG_ON(len & 1);
-		for (; len; len -=3D 2)
-			rfbi_write_reg(RFBI_CMD, *w++);
